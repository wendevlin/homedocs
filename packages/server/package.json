{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOCS_ROOT=../../.dev/docs DATA_DIR=../../.dev/data DEV_USER_ID=dev-admin bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --sourcemap=linked --outdir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@homedocs/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
